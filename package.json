{
  "name": "slopinator",
  "productName": "Slopinator",
  "version": "0.1.0",
  "description": "Audio mastering app wrapping the master.py chain",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "freeze-python": "bash scripts/freeze-python.sh",
    "prepack": "npm run freeze-python",
    "pack": "electron-builder --dir",
    "postpack": "bash scripts/sign-mac.sh",
    "predist": "npm run freeze-python",
    "dist": "electron-builder",
    "postdist": "bash scripts/sign-mac.sh"
  },
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.slopinator.app",
    "productName": "Slopinator",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "build/pyinstaller/master", "to": "master-bin" }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": "dmg"
    },
    "directories": {
      "output": "dist"
    }
  }
}
